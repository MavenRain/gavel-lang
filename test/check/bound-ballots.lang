-- REFUSE_BOUND (S7, Q-S7-10 (a)): a closed ballot list with 1025 ballots
def bZero : Ballot := ballot (party sz0) (hash sz0) (inr unit)
def addBallot : Ballots -> Ballots := fun (bs : Ballots) => blCons bZero bs
def addBallot4 : Ballots -> Ballots := fun (bs : Ballots) => addBallot (addBallot (addBallot (addBallot bs)))
def addBallot16 : Ballots -> Ballots := fun (bs : Ballots) => addBallot4 (addBallot4 (addBallot4 (addBallot4 bs)))
def addBallot64 : Ballots -> Ballots := fun (bs : Ballots) => addBallot16 (addBallot16 (addBallot16 (addBallot16 bs)))
def addBallot256 : Ballots -> Ballots := fun (bs : Ballots) => addBallot64 (addBallot64 (addBallot64 (addBallot64 bs)))
def addBallot1024 : Ballots -> Ballots := fun (bs : Ballots) => addBallot256 (addBallot256 (addBallot256 (addBallot256 bs)))
def big : Ballots := addBallot (addBallot1024 blNil)
