-- S = b.y Z^3, H = U - X, R = S - Y (11 feMul with ptMaddH). H = 0 gives 2 a
-- when R = 0, else the point at infinity.
def ptMaddRaw : FeMod -> Jac -> Pt1 -> Jac :=
  fun (md : FeMod) (a : Jac) (b : Pt1) =>
    ptLet (feMulC md (jcZ a) (jcZ a)) (fun (zz : Fe) =>
    ptLet (feSub md (feMulC md (p1X b) zz) (jcX a)) (fun (h : Fe) =>
    ptLet (feSub md (feMulC md (feMulC md (p1Y b) zz) (jcZ a)) (jcY a)) (fun (r : Fe) =>
    either (fun (u : Unit) => ptMaddH md a h r)
      (fun (u : Unit) => either (fun (v : Unit) => jacZero) (fun (v : Unit) => ptDbl md a) (feIsZero r))
      (feIsZero h))))
-- ptMadd md a b is a + b for a Jacobian a and an affine b. b at infinity
-- gives a. a at infinity gives (b.x, b.y, 1).
def ptMadd : FeMod -> Jac -> Pt1 -> Jac :=
  fun (md : FeMod) (a : Jac) (b : Pt1) =>
    either (fun (u : Unit) =>
      either (fun (v : Unit) => ptMaddRaw md a b) (fun (v : Unit) => jac (p1X b) (p1Y b) (modR1 md)) (feIsZero (jcZ a)))
      (fun (u : Unit) => a) (p1IsInf b)
-- ptToAffine md a is (X / Z^2, Y / Z^3): one feInv and 4 feMul. Z = 0 gives
-- (0, 0).
def ptToAffine : FeMod -> Jac -> Pt1 :=
  fun (md : FeMod) (a : Jac) =>
    either (fun (u : Unit) =>
      (fun (zi : Fe) => (fun (zi2 : Fe) => pt1 (feMulC md (jcX a) zi2) (feMulC md (jcY a) (feMulC md zi2 zi))) (feMulC md zi zi)) (feInv md (jcZ a)))
