-- spec ptMul on the same scalar k and point p (p in Montgomery form). A row
-- gives 1 when the two points are equal.
def oPtMulC : FeMod -> Fe -> Pt1 -> Nat := fun (md : FeMod) (k : Fe) (p : Pt1) => (fun (q : Pt1) => either (fun (u : Unit) => 0) (fun (u : Unit) => 1) (p1Eq (ptMulC md k q) (ptMul md k q))) (ptToMont md p)
def curveMulC : Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Nat := fun (a0 : Word) (a1 : Word) (a2 : Word) (a3 : Word) (a4 : Word) (a5 : Word) (a6 : Word) (a7 : Word) (a8 : Word) (a9 : Word) (a10 : Word) (a11 : Word) (a12 : Word) (a13 : Word) (a14 : Word) (a15 : Word) (a16 : Word) (a17 : Word) (a18 : Word) (a19 : Word) (a20 : Word) (a21 : Word) (a22 : Word) (a23 : Word) => oPtMulC fpMod (fe a0 a1 a2 a3 a4 a5 a6 a7) (pt1 (fe a8 a9 a10 a11 a12 a13 a14 a15) (fe a16 a17 a18 a19 a20 a21 a22 a23))
-- The hsMsg rows (S8a). hsMsgRow takes t, x, y and h (8 Words each, not in
-- Montgomery form). It gives 1 when hsMsg of t, x and y is h.
def oHsMsg : Fe -> Fe -> Fe -> Fe -> Nat :=
  fun (t : Fe) (x : Fe) (y : Fe) (h : Fe) => either (fun (u : Unit) => 0) (fun (u : Unit) => 1) (feEq (hsMsg (feToMont frMod t) (feToMont frMod x) (feToMont frMod y)) h)
def hsMsgRow : Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Nat := fun (w0 : Word) (w1 : Word) (w2 : Word) (w3 : Word) (w4 : Word) (w5 : Word) (w6 : Word) (w7 : Word) (w8 : Word) (w9 : Word) (w10 : Word) (w11 : Word) (w12 : Word) (w13 : Word) (w14 : Word) (w15 : Word) (w16 : Word) (w17 : Word) (w18 : Word) (w19 : Word) (w20 : Word) (w21 : Word) (w22 : Word) (w23 : Word) (w24 : Word) (w25 : Word) (w26 : Word) (w27 : Word) (w28 : Word) (w29 : Word) (w30 : Word) (w31 : Word) => oHsMsg (fe w0 w1 w2 w3 w4 w5 w6 w7) (fe w8 w9 w10 w11 w12 w13 w14 w15) (fe w16 w17 w18 w19 w20 w21 w22 w23) (fe w24 w25 w26 w27 w28 w29 w30 w31)
-- The fixture rows (S8a). msgNAME is the word of the fixture message NAME,
-- in the form of the type switch. ckNAMEKK is schnorrCheck on the key
-- fxKeyK, the signature of the key K on NAME and msgNAME. Each ck row must
-- give inr unit.
def msgHs2 : Fe := feFromMont frMod (szToFe (szS (szS sz0)))
def msgHs3 : Fe := feFromMont frMod (szToFe (szS (szS (szS sz0))))
def msgStA : Fe := hsMsg (szToFe sz0) (szToFe (szS sz0)) (szToFe (szS sz0))
def msgStL : Fe := hsMsg (szToFe sz0) (szToFe (szS sz0)) (szToFe (szS (szS sz0)))
def msgOpA : Fe := hsMsg (szToFe (szS sz0)) (szToFe (szS sz0)) (szToFe (szS (szS sz0)))
def msgOpE : Fe := hsMsg (szToFe (szS sz0)) (szToFe (szS sz0)) (szToFe (szS sz0))
def msgAmA : Fe := hsMsg (szToFe (szS (szS sz0))) (szToFe sz0) (szToFe sz0)
