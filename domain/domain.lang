def lnChi : Lane -> Lane -> Lane -> Lane := fun (a : Lane) (b : Lane) (c : Lane) => lane (wXor (lnLo a) (wAnd (wNot (lnLo b)) (lnLo c))) (wXor (lnHi a) (wAnd (wNot (lnHi b)) (lnHi c)))
