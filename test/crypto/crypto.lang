def fpInv : Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Nat := fun (a0 : Word) (a1 : Word) (a2 : Word) (a3 : Word) (a4 : Word) (a5 : Word) (a6 : Word) (a7 : Word) (a8 : Word) (a9 : Word) (a10 : Word) (a11 : Word) (a12 : Word) (a13 : Word) (a14 : Word) (a15 : Word) => oInv fpMod (fe a0 a1 a2 a3 a4 a5 a6 a7) (fe a8 a9 a10 a11 a12 a13 a14 a15)
