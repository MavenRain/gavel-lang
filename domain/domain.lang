-- Poseidon hash of 2 inputs (828 feMulC).
def poseidon2 : FeMod -> PsMds -> PsRcs -> Fe -> Fe -> Fe :=
  fun (md : FeMod) (mx : PsMds) (rcs : PsRcs) (x : Fe) (y : Fe) => ps0 (poseidonPerm md mx rcs (pst feZero x y))
