def frE2 : FeBits :=
  fbOne (fbOne (fbOne (fbZero (fbZero (fbZero (fbZero (fbOne (fbZero (fbOne (fbZero (fbZero (fbZero (fbZero (fbZero (fbOne (fbZero (fbZero (fbZero (fbOne (fbZero (fbOne (fbOne (fbZero (fbOne (fbOne (fbZero (fbOne (fbOne (fbZero (fbOne (fbZero (frE3))))))))))))))))))))))))))))))))
def frE1 : FeBits :=
  fbOne (fbZero (fbZero (fbZero (fbZero (fbOne (fbZero (fbZero (fbOne (fbOne (fbZero (fbZero (fbZero (fbOne (fbOne (fbZero (fbOne (fbZero (fbZero (fbZero (fbZero (fbZero (fbZero (fbZero (fbOne (fbZero (fbOne (fbZero (fbZero (fbOne (fbOne (fbZero (frE2))))))))))))))))))))))))))))))))
def frE0 : FeBits :=
