-- aggregate is a defined name of the design signature: the kernel gives it after act and outcomeSet, so a program def aggregate is refused.
def Member : Type 0 := Sum Unit Unit
def Choice : Type 0 := Sum Unit Unit
def DaoOutcome : Type 0 := Trunc0 Unit
def Group : Type 0 := Sum Unit Unit
def flip : Choice -> Choice := fun (c : Choice) => either (fun (u : Unit) => inr unit) (fun (u : Unit) => inl unit) c
def act : Group -> (Member -> Choice) -> Member -> Choice :=
  fun (g : Group) (f : Member -> Choice) (m : Member) => either (fun (u : Unit) => f m) (fun (u : Unit) => flip (f m)) g
def outcomeSet : isSet DaoOutcome := fun (x : DaoOutcome) (y : DaoOutcome) (p : Path DaoOutcome x y) (q : Path DaoOutcome x y) => fun (i : I) => fun (j : I) => squash0 Unit x y p q i j
def aggregate : Unit := unit
