def psFullRound : FeMod -> PsMds -> Fe -> Fe -> Fe -> PsState -> PsState :=
  fun (md : FeMod) (mx : PsMds) (a : Fe) (b : Fe) (c : Fe) (s : PsState) => psMix md mx (psSbox md (feAdd md (ps0 s) a)) (psSbox md (feAdd md (ps1 s) b)) (psSbox md (feAdd md (ps2 s) c))
def psPartRound : FeMod -> PsMds -> Fe -> Fe -> Fe -> PsState -> PsState :=
  fun (md : FeMod) (mx : PsMds) (a : Fe) (b : Fe) (c : Fe) (s : PsState) => psMix md mx (psSbox md (feAdd md (ps0 s) a)) (feAdd md (ps1 s) b) (feAdd md (ps2 s) c)
