-- item first.
def poseidonPerm : FeMod -> PsMds -> PsRcs -> PsState -> PsState :=
  fun (md : FeMod) (mx : PsMds) (rcs : PsRcs) => elim (fun (k : PsRcs) => PsState -> PsState)
