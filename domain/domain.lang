    (fun (t : FeBits) (ih : Jac -> Jac) => fun (a : Jac) => ih (ptDbl md a))
    (fun (t : FeBits) (ih : Jac -> Jac) => fun (a : Jac) => ih (ptMadd md (ptDbl md a) p)) e
