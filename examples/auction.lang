-- The auction outcome (S4, USER rulings Q-S4-4 (a) and Q-S4-5 (a)), guest
-- mode: closed refl rows for the first price, the second price, a tie, the
-- empty list, all bids below the reserve, a bid equal to the reserve, the
-- reserve floor and one eligible bid under the second price. The amounts
-- are literals (Q-S4-1 (a)). The general laws are in domain/domain.lang.
def one : Amount := amSucc amZero
def two : Amount := amSucc (amSucc amZero)
def three : Amount := amSucc (amSucc (amSucc amZero))
def four : Amount := amSucc (amSucc (amSucc (amSucc amZero)))
def five : Amount := amSucc (amSucc (amSucc (amSucc (amSucc amZero))))
-- The bids 3, 5, 2: the top is 5 at index 1, the second highest is 3.
def bids : Bids := bdCons three (bdCons five (bdCons two bdNil))
def firstOf : Outcome := outcome firstPrice amZero bids
def secondOf : Outcome := outcome secondPrice amZero bids
def firstIsTop : Path Outcome firstOf (sale (szS sz0) five) := refl
def secondIsNext : Path Outcome secondOf (sale (szS sz0) three) := refl
-- A tie, 5, 5, 2: the lowest index wins and the second price is the top bid.
def tied : Bids := bdCons five (bdCons five (bdCons two bdNil))
def tieOf : Outcome := outcome secondPrice amZero tied
def tieFirst : Path Outcome (outcome firstPrice amZero tied) (sale sz0 five) := refl
def tieSecond : Path Outcome tieOf (sale sz0 five) := refl
-- The empty list: no sale under both rules.
def emptyFirst : Path Outcome (outcome firstPrice amZero bdNil) noSale := refl
def emptySecond : Path Outcome (outcome secondPrice one bdNil) noSale := refl
-- The bids 3, 2 below the reserve 5: no sale. A bid equal to the reserve is
-- eligible.
def low : Bids := bdCons three (bdCons two bdNil)
def noneOf : Outcome := outcome firstPrice five low
def belowReserve : Path Outcome noneOf noSale := refl
def atReserve : Path Outcome (outcome firstPrice three low) (sale sz0 three) := refl
-- The reserve floor: with the reserve 5 the second price is 5, not 3. With
-- the reserve 4 only the bid 5 is eligible, so the price is the reserve.
def reserveFloor : Path Outcome (outcome secondPrice five bids) (sale (szS sz0) five) := refl
def oneEligible : Path Outcome (outcome secondPrice four bids) (sale (szS sz0) four) := refl
