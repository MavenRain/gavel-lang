-- The BN254 moduli (quorum-lang src/crypto/bn254.h): r for Fr, p for Fp.
def frMod : FeMod := feMod (fe 0xf0000001w 0x43e1f593w 0x79b97091w 0x2833e848w 0x8181585dw 0xb85045b6w 0xe131a029w 0x30644e72w) 0xefffffffw (fe 0xae216da7w 0x1bb8e645w 0xe35c59e3w 0x53fe3ab1w 0x53bb8085w 0x8c49833dw 0x7f4e44a5w 0x0216d0b1w) (fe 0x4ffffffbw 0xac96341cw 0x9f60cd29w 0x36fc7695w 0x7879462ew 0x666ea36fw 0x9a07df2fw 0x0e0a77c1w) frE0
def fpMod : FeMod := feMod (fe 0xd87cfd47w 0x3c208c16w 0x6871ca8dw 0x97816a91w 0x8181585dw 0xb85045b6w 0xe131a029w 0x30644e72w) 0xe4866389w (fe 0x538afa89w 0xf32cfc5bw 0xd44501fbw 0xb5e71911w 0x0a417ff6w 0x47ab1effw 0xcab8351fw 0x06d89f71w) (fe 0xc58f0d9dw 0xd35d438dw 0xf5c70b3dw 0x0a78eb28w 0x7879462cw 0x666ea36fw 0x9a07df2fw 0x0e0a77c1w) fpE0
-- fePowFrom md a e x is x^(2^n) a^e for the n bits of e (the top bit first),
-- in Montgomery form. Each bit squares the value, and a 1 bit then multiplies
-- it by a.
def fePowFrom : FeMod -> Fe -> FeBits -> Fe -> Fe :=
  fun (md : FeMod) (a : Fe) (e : FeBits) => elim (fun (k : FeBits) => Fe -> Fe)
    (fun (x : Fe) => x)
    (fun (t : FeBits) (ih : Fe -> Fe) => fun (x : Fe) => ih (feMulC md x x))
    (fun (t : FeBits) (ih : Fe -> Fe) => fun (x : Fe) => ih (feMulC md (feMulC md x x) a)) e
-- fePow md a e is a^e. The start value is R mod m (1 in Montgomery form).
def fePow : FeMod -> Fe -> FeBits -> Fe :=
  fun (md : FeMod) (a : Fe) (e : FeBits) => fePowFrom md a e (modR1 md)
-- feInv md a is a^(m - 2) (Fermat). It is the inverse of a when a is not 0,
-- and 0 when a is 0.
def feInv : FeMod -> Fe -> Fe := fun (md : FeMod) (a : Fe) => fePow md a (modE md)
-- The scalar field Fr (modulus r, frMod) and the base field Fp (modulus p,
-- fpMod). A value is an Fe in Montgomery form.
def Fr : Type 0 := Fe
def Fp : Type 0 := Fe
-- The BN254 G1 curve y^2 = x^3 + 3 over Fp (S8a, Q-S8-4 (a)). A Pt1 is an
-- affine point (x, y), and (0, 0) is the point at infinity (quorum-lang
-- src/crypto/bn254.h). At the boundary the coordinates are canonical. Inside
-- a point op they are in Montgomery form.
family Pt1 := pt1 (p1X : Fe) (p1Y : Fe)
-- A Jac is a point (X, Y, Z) in Jacobian form: the affine point
-- (X / Z^2, Y / Z^3), in Montgomery form. Z = 0 is the point at infinity.
family Jac := jac (jcX : Fe) (jcY : Fe) (jcZ : Fe)
def jacZero : Jac := jac feZero feZero feZero
-- p1Eq p q is inr unit when the coordinates of p and q are equal. For
-- canonical points, this is the point equality.
def p1Eq : Pt1 -> Pt1 -> Sum Unit Unit :=
  fun (p : Pt1) (q : Pt1) => sAnd (feEq (p1X p) (p1X q)) (feEq (p1Y p) (p1Y q))
-- p1IsInf p is inr unit when p is (0, 0).
def p1IsInf : Pt1 -> Sum Unit Unit := fun (p : Pt1) => sAnd (feIsZero (p1X p)) (feIsZero (p1Y p))
-- The Montgomery form of a point, and back. Each point op takes the modulus
-- as a binder: then the check does not unroll it (S8).
def ptToMont : FeMod -> Pt1 -> Pt1 := fun (md : FeMod) (p : Pt1) => pt1 (feToMont md (p1X p)) (feToMont md (p1Y p))
def ptFromMont : FeMod -> Pt1 -> Pt1 := fun (md : FeMod) (p : Pt1) => pt1 (feFromMont md (p1X p)) (feFromMont md (p1Y p))
def jacToMont : FeMod -> Jac -> Jac := fun (md : FeMod) (a : Jac) => jac (feToMont md (jcX a)) (feToMont md (jcY a)) (feToMont md (jcZ a))
-- ptLet x k is k x. It binds one value of a point op.
def ptLet : Fe -> (Fe -> Jac) -> Jac := fun (x : Fe) (k : Fe -> Jac) => k x
-- ptDblRaw md a is 2 a when Z and Y are not 0 (src/crypto/bn254.c
-- ec0_jac_double, 7 feMul): S = 4 X Y^2, M = 3 X^2, X3 = M^2 - 2 S,
-- Y3 = M (S - X3) - 8 Y^4, Z3 = 2 Y Z.
def ptDblRaw : FeMod -> Jac -> Jac :=
  fun (md : FeMod) (a : Jac) =>
    ptLet (feMulC md (jcY a) (jcY a)) (fun (yy : Fe) =>
    ptLet (feMulC md (jcX a) yy) (fun (s1 : Fe) =>
    ptLet (feAdd md s1 s1) (fun (s2 : Fe) =>
    ptLet (feAdd md s2 s2) (fun (s : Fe) =>
    ptLet (feMulC md (jcX a) (jcX a)) (fun (xx : Fe) =>
    ptLet (feAdd md (feAdd md xx xx) xx) (fun (m : Fe) =>
    ptLet (feSub md (feSub md (feMulC md m m) s) s) (fun (x3 : Fe) =>
    ptLet (feMulC md yy yy) (fun (y4 : Fe) =>
    ptLet (feAdd md y4 y4) (fun (y42 : Fe) =>
    ptLet (feAdd md y42 y42) (fun (y44 : Fe) =>
    ptLet (feAdd md y44 y44) (fun (y48 : Fe) =>
    ptLet (feMulC md (jcY a) (jcZ a)) (fun (yz : Fe) =>
    jac x3 (feSub md (feMulC md m (feSub md s x3)) y48) (feAdd md yz yz)))))))))))))
-- ptDbl md a is 2 a. Z = 0 or Y = 0 gives the point at infinity.
def ptDbl : FeMod -> Jac -> Jac :=
  fun (md : FeMod) (a : Jac) =>
    either (fun (u : Unit) => ptDblRaw md a) (fun (u : Unit) => jacZero) (sOr (feIsZero (jcZ a)) (feIsZero (jcY a)))
-- ptMaddH md a h r is the end of ptMadd when H is not 0 (src/crypto/bn254.c
-- ec0_jac_add_affine): X3 = R^2 - H^3 - 2 X H^2, Y3 = R (X H^2 - X3) - Y H^3,
-- Z3 = Z H.
def ptMaddH : FeMod -> Jac -> Fe -> Fe -> Jac :=
  fun (md : FeMod) (a : Jac) (h : Fe) (r : Fe) =>
    ptLet (feMulC md h h) (fun (hh : Fe) =>
    ptLet (feMulC md h hh) (fun (hhh : Fe) =>
    ptLet (feMulC md (jcX a) hh) (fun (v : Fe) =>
    ptLet (feSub md (feSub md (feSub md (feMulC md r r) hhh) v) v) (fun (x3 : Fe) =>
    jac x3 (feSub md (feMulC md r (feSub md v x3)) (feMulC md (jcY a) hhh)) (feMulC md (jcZ a) h)))))
