def frE5 : FeBits :=
  fbOne (fbOne (fbOne (fbZero (fbZero (fbOne (fbOne (fbZero (fbOne (fbOne (fbOne (fbZero (fbZero (fbOne (fbZero (fbOne (fbOne (fbOne (fbZero (fbZero (fbZero (fbZero (fbOne (fbZero (fbZero (fbOne (fbZero (fbZero (fbZero (fbOne (fbZero (fbOne (frE6))))))))))))))))))))))))))))))))
def frE4 : FeBits :=
