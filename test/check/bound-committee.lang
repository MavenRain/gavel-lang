-- REFUSE_BOUND (S5, Q-S5-7 (a)): a closed committee with 1025 members is above the bound of 1024
def addMember : Members -> Members := fun (ms : Members) => mbCons (party fxKey1) ms
def addMember4 : Members -> Members := fun (ms : Members) => addMember (addMember (addMember (addMember ms)))
def addMember16 : Members -> Members := fun (ms : Members) => addMember4 (addMember4 (addMember4 (addMember4 ms)))
def addMember64 : Members -> Members := fun (ms : Members) => addMember16 (addMember16 (addMember16 (addMember16 ms)))
def addMember256 : Members -> Members := fun (ms : Members) => addMember64 (addMember64 (addMember64 (addMember64 ms)))
def addMember1024 : Members -> Members := fun (ms : Members) => addMember256 (addMember256 (addMember256 (addMember256 ms)))
def big : Members := addMember (addMember1024 mbNil)
