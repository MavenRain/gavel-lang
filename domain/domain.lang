-- The committee (S5, design section 4, USER rulings Q-S5-1 to Q-S5-11).
-- A Hash is a value in Fr, not in Montgomery form, and hsOf n is the Hash
-- of the Size n. A Party is a BN254 G1 key (S8a; before S8a a Size tag
-- and a Size key, Q-S5-3 (a), Q-S5-1 (a)). Members is the list of
-- the committee members and n is its length. t, n, f and the amend
-- threshold ta are Size values (Q-S5-2 (a)). The compare and the test
-- words give Sum Unit Unit as amLe: inr unit is "yes".
family Hash := hash (hsTag : Fe)
family Party := party (ptKey : Pt1)
family Members := mbNil | mbCons (mbHead : Party) (mbTail : Members)
def ptEq : Party -> Party -> Sum Unit Unit := fun (p : Party) (q : Party) => scPtEq (ptKey p) (ptKey q)
def hsEq : Hash -> Hash -> Sum Unit Unit := fun (g : Hash) (h : Hash) => feEq (hsTag g) (hsTag h)
def hsCanonical : Hash -> Sum Unit Unit := fun (h : Hash) => feLt (hsTag h) (modM frMod)
def hsOf : Size -> Hash := fun (n : Size) => hash (feFromMont frMod (szToFe n))
def mbLen : Members -> Size :=
  fun (ms : Members) => elim (fun (k : Members) => Size) sz0 (fun (h : Party) (t : Members) (ih : Size) => szS ih) ms
def mbHas : Party -> Members -> Sum Unit Unit :=
  fun (p : Party) (ms : Members) => elim (fun (k : Members) => Sum Unit Unit) (inl unit)
    (fun (h : Party) (t : Members) (ih : Sum Unit Unit) => sOr (ptEq p h) ih) ms
def mbDistinct : Members -> Sum Unit Unit :=
  fun (ms : Members) => elim (fun (k : Members) => Sum Unit Unit) (inr unit)
    (fun (h : Party) (t : Members) (ih : Sum Unit Unit) => sAnd (sNot (mbHas h t)) ih) ms
-- The laws G1 to G3 are proof fields (Q-S5-5 (c), Q-S5-10 (a)): each value
-- of Committee and Params carries its proofs, so the laws hold for open
-- inputs too. G1 (cmSafe): no party is in the members two times, and f < t.
-- G2 (cmCensor): t + f <= n. G3 (prFork, on ta, Q-S5-6 (b)): n + f <
-- ta + ta, that is 2ta - n > f. When the kernel cannot check a proof
-- field, the checker gives the law code: REFUSE_SAFETY, REFUSE_CENSOR or
-- REFUSE_FORK (Q-S5-9 (a)).
def cmG1 : Members -> Size -> Size -> Sum Unit Unit :=
  fun (ms : Members) (t : Size) (f : Size) => sAnd (mbDistinct ms) (szLt f t)
def cmG2 : Members -> Size -> Size -> Sum Unit Unit :=
  fun (ms : Members) (t : Size) (f : Size) => szLe (szAdd t f) (mbLen ms)
family Committee := committee (cmMembers : Members) (cmT : Size) (cmF : Size) (cmSafe : Path (Sum Unit Unit) (cmG1 cmMembers cmT cmF) (inr unit)) (cmCensor : Path (Sum Unit Unit) (cmG2 cmMembers cmT cmF) (inr unit))
def prG3 : Committee -> Size -> Sum Unit Unit :=
  fun (c : Committee) (ta : Size) => szLt (szAdd (mbLen (cmMembers c)) (cmF c)) (szAdd ta ta)
-- The slot and the heights (S6, Q-S6-6 (a), Q-S6-1 (b)): a deposit slot is
-- a Size tag. There is no clock: a height is a log height, and a deadline
-- is a height that a t-of-n certificate fixes. Params keeps the slot, the
-- stamp end prStampEnd (the last height of a bid timestamp) and the
-- release height prRelease. The proof field prOrder (Q-S6-9 (a)) says
-- that the stamp end is before the release; when the kernel cannot check
-- it, the checker gives REFUSE_DEADLINE. prOrder is after prFork, so a G3
-- failure comes first.
family Slot := slot (soTag : Size)
family Height := height (htOf : Size)
def htLe : Height -> Height -> Sum Unit Unit := fun (g : Height) (h : Height) => szLe (htOf g) (htOf h)
def htLt : Height -> Height -> Sum Unit Unit := fun (g : Height) (h : Height) => szLt (htOf g) (htOf h)
family Params := params (prRule : Rule) (prReserve : Amount) (prCommittee : Committee) (prAmendT : Size) (prSlot : Slot) (prStampEnd : Height) (prRelease : Height) (prFork : Path (Sum Unit Unit) (prG3 prCommittee prAmendT) (inr unit)) (prOrder : Path (Sum Unit Unit) (htLt prStampEnd prRelease) (inr unit))
-- The certificate (Q-S5-4 (a), S8a): a list of Schnorr signatures, each a
-- signer and a signature (R, s). checkCert c h cs counts each member of c
-- one time when cs has an entry with that signer that schnorrCheck accepts
-- on the key of the signer and the message h, and accepts (inr unit) when
-- the count is at least t. Two entries of one signer count one time.
-- ctHas runs schnorrCheck only on an entry of the signer p.
family Certificate := ctNil | ctCons (ctSigner : Party) (ctR : Pt1) (ctS : Fe) (ctRest : Certificate)
def ctHas : Party -> Hash -> Certificate -> Sum Unit Unit :=
  fun (p : Party) (h : Hash) (cs : Certificate) => elim (fun (k : Certificate) => Sum Unit Unit) (inl unit)
    (fun (s : Party) (r : Pt1) (z : Fe) (t : Certificate) (ih : Sum Unit Unit) => elim (fun (b : Sum Unit Unit) => Sum Unit Unit) (fun (u : Unit) => ih) (fun (u : Unit) => sOr (schnorrCheck kcRcs (ptKey p) r z (hsTag h)) ih) (ptEq p s)) cs
def ctCount : Members -> Hash -> Certificate -> Size :=
  fun (ms : Members) (h : Hash) (cs : Certificate) => elim (fun (k : Members) => Size) sz0
    (fun (q : Party) (t : Members) (ih : Size) => elim (fun (s : Sum Unit Unit) => Size) (fun (u : Unit) => ih) (fun (u : Unit) => szS ih) (ctHas q h cs)) ms
def checkCert : Committee -> Hash -> Certificate -> Sum Unit Unit :=
  fun (c : Committee) (h : Hash) (cs : Certificate) => szLe (cmT c) (ctCount (cmMembers c) h cs)
-- The outcome of the parameters (Q-S4-4 (a)).
def outcomeOf : Params -> Bids -> Outcome := fun (p : Params) (bs : Bids) => outcome (prRule p) (prReserve p) bs
-- The sealed bid (S6, design section 5, USER rulings Q-S6-1 to Q-S6-9).
-- The auction name is a Size tag (Q-S6-6 (a)). Root, Handle and
-- Commitment wrap a Hash; a Deposit is the owner and the secret hash, with
-- no amount. The compare words give Sum Unit Unit: inr unit is "yes".
family AucID := aucId (auTag : Size)
family Root := root (rtHash : Hash)
family Handle := handle (hdHash : Hash)
family Commitment := commitment (coHash : Hash)
family Deposit := deposit (dpOwner : Size) (dpSecret : Hash)
def auEq : AucID -> AucID -> Sum Unit Unit := fun (a : AucID) (b : AucID) => szEq (auTag a) (auTag b)
def rtEq : Root -> Root -> Sum Unit Unit := fun (a : Root) (b : Root) => hsEq (rtHash a) (rtHash b)
def hdEq : Handle -> Handle -> Sum Unit Unit := fun (a : Handle) (b : Handle) => hsEq (hdHash a) (hdHash b)
def coEq : Commitment -> Commitment -> Sum Unit Unit := fun (a : Commitment) (b : Commitment) => hsEq (coHash a) (coHash b)
-- The eligibility proof is an ideal record of the statement (root, handle,
-- commitment) (Q-S6-5 (a)): elgVrf says yes when the three match. At S8b
-- the match becomes the Noir verifier.
family EligibilityProof := elgProof (epRoot : Root) (epHandle : Handle) (epCommit : Commitment)
def elgVrf : Root -> Handle -> Commitment -> EligibilityProof -> Sum Unit Unit :=
  fun (r : Root) (h : Handle) (c : Commitment) (e : EligibilityProof) =>
    sAnd (rtEq r (epRoot e)) (sAnd (hdEq h (epHandle e)) (coEq c (epCommit e)))
-- The sealed value (P1, Q-S6-3 (a)) is a cell monad. A guest program makes
-- a sealed value with seal, but an elim, a fold or a projection of Sealed
-- in a guest program def gives REFUSE_PEEK. Only the domain word release
-- reads sealOf. The FHE ciphertext and the MPC shares are Sealed Amount in
-- the clear denotation until S13 and S14.
sealed family Sealed (A : Type 0) := seal (sealOf : A)
family SealedBid := sealedBid (sbHandle : Handle) (sbCommit : Commitment) (sbProof : EligibilityProof) (sbBid : Sealed Amount)
family SealedBids := sbNil | sbCons (sbsHead : SealedBid) (sbsTail : SealedBids)
-- The verdicts (Q-S6-7 (a)). Handles is the set of the slashed handles; at
-- S7 the Log gives it.
family Reason := badCert | badProof | late | early | slashed | notAccepted | wrongHeight | malformed
family Verdict := valid | invalid (vdWhy : Reason)
family Handles := hlNil | hlCons (hlHead : Handle) (hlTail : Handles)
def hlHas : Handle -> Handles -> Sum Unit Unit :=
  fun (h : Handle) (hs : Handles) => elim (fun (k : Handles) => Sum Unit Unit) (inl unit)
    (fun (g : Handle) (t : Handles) (ih : Sum Unit Unit) => sOr (hdEq h g) ih) hs
-- vdCheck s w v is v when s says yes, else invalid w.
def vdCheck : Sum Unit Unit -> Reason -> Verdict -> Verdict :=
  fun (s : Sum Unit Unit) (w : Reason) (v : Verdict) => elim (fun (k : Sum Unit Unit) => Verdict) (fun (u : Unit) => invalid w) (fun (u : Unit) => v) s
-- The message words (Q-S6-8 (a), S8a): hsMsg of a kind tag and two words.
-- The kind tag is 0 for a stamp, 1 for an opening and 2 for an amendment
-- (amendMsg), so two messages of different kinds are not equal. Each word
-- is in Montgomery form; the Hash is canonical.
def stampMsg : Commitment -> Height -> Hash :=
  fun (c : Commitment) (h : Height) => hash (hsMsg (szToFe sz0) (feToMont frMod (hsTag (coHash c))) (szToFe (htOf h)))
def openMsg : AucID -> Height -> Hash :=
  fun (a : AucID) (h : Height) => hash (hsMsg (szToFe (szS sz0)) (szToFe (auTag a)) (szToFe (htOf h)))
-- admit p sl r b h cs (Q-S6-7 (a)) checks the bid b with the timestamp
-- certificate cs at the height h, in this order: invalid late when h is
-- after the stamp end, invalid badCert when cs does not certify the stamp
-- message of b at h or the commitment tag is not canonical Fr, invalid
-- slashed when the handle of b is in sl,
-- invalid badProof when the eligibility proof does not check at the root
-- r, else valid.
def admit : Params -> Handles -> Root -> SealedBid -> Height -> Certificate -> Verdict :=
  fun (p : Params) (sl : Handles) (r : Root) (b : SealedBid) (h : Height) (cs : Certificate) =>
    vdCheck (htLe h (prStampEnd p)) late
      (vdCheck (sAnd (hsCanonical (coHash (sbCommit b))) (checkCert (prCommittee p) (stampMsg (sbCommit b) h) cs)) badCert
        (vdCheck (sNot (hlHas (sbHandle b) sl)) slashed
          (vdCheck (elgVrf r (sbHandle b) (sbCommit b) (sbProof b)) badProof valid)))
-- slash r h c e d f (Q-S6-4 (a)) checks two bids of the handle h: invalid
-- notAccepted when the commitments are equal, invalid badProof when one of
-- the two proofs does not check at the root r, else valid (slash h). The
-- log entry and replay are S7.
def slash : Root -> Handle -> Commitment -> EligibilityProof -> Commitment -> EligibilityProof -> Verdict :=
  fun (r : Root) (h : Handle) (c : Commitment) (e : EligibilityProof) (d : Commitment) (f : EligibilityProof) =>
    vdCheck (sNot (coEq c d)) notAccepted (vdCheck (sAnd (elgVrf r h c e) (elgVrf r h d f)) badProof valid)
-- P3 (Q-S6-4 (a)): slash on two equal commitments is never valid.
def szEqRefl : (x : Size) -> Path (Sum Unit Unit) (szEq x x) (inr unit) :=
  fun (x : Size) => elim (fun (a : Size) => Path (Sum Unit Unit) (szEq a a) (inr unit)) refl
    (fun (a : Size) (ih : Path (Sum Unit Unit) (szEq a a) (inr unit)) => ih) x
-- feEqRefl a: feEq a a is inr unit also for an open a. The kernel reduces
-- wEq x y to inr unit when x and y have the same form (Q-S8a-8 (a)).
def feEqRefl : (a : Fe) -> Path (Sum Unit Unit) (feEq a a) (inr unit) :=
  fun (a : Fe) => refl
def p3Slash : (r : Root) -> (h : Handle) -> (c : Commitment) -> (e : EligibilityProof) -> (f : EligibilityProof) -> Path Verdict (slash r h c e c f) (invalid notAccepted) :=
  fun (r : Root) (h : Handle) (c : Commitment) (e : EligibilityProof) (f : EligibilityProof) =>
    cong (fun (s : Sum Unit Unit) => vdCheck (sNot s) notAccepted (vdCheck (sAnd (elgVrf r h c e) (elgVrf r h c f)) badProof valid)) (feEqRefl (hsTag (coHash c)))
-- The opening (P2, Q-S6-2 (a)): the proof field opOk says that t members
-- of the committee certify the open message of the auction at the release
-- height. When the kernel cannot check opOk, the checker gives
-- REFUSE_PEEK. release opens the whole list in one call.
family Opening := opening (opAuc : AucID) (opParams : Params) (opCert : Certificate) (opOk : Path (Sum Unit Unit) (checkCert (prCommittee opParams) (openMsg opAuc (prRelease opParams)) opCert) (inr unit))
def release : Opening -> SealedBids -> Bids :=
  fun (o : Opening) (bs : SealedBids) => elim (fun (k : SealedBids) => Bids) bdNil
    (fun (b : SealedBid) (t : SealedBids) (ih : Bids) => bdCons (sealOf (sbBid b)) ih) bs
-- S7: the log (design section 6, USER rulings Q-S7-1 to Q-S7-10).
-- A ballot is the vote of a party on a topic hash; blYes inr unit is "yes".
-- authorize p t bs counts each committee member one time when bs has a yes
-- ballot of that member on t, and accepts (inr unit) when the count is at
-- least the amend threshold ta (Q-S7-2 (a)). G1 makes the members distinct.
family Ballot := ballot (blVoter : Party) (blTopic : Hash) (blYes : Sum Unit Unit)
family Ballots := blNil | blCons (blHead : Ballot) (blTail : Ballots)
def blHas : Party -> Hash -> Ballots -> Sum Unit Unit :=
  fun (p : Party) (t : Hash) (bs : Ballots) => elim (fun (k : Ballots) => Sum Unit Unit) (inl unit)
    (fun (b : Ballot) (r : Ballots) (ih : Sum Unit Unit) => sOr (sAnd (ptEq (blVoter b) p) (sAnd (hsEq (blTopic b) t) (blYes b))) ih) bs
def blCount : Members -> Hash -> Ballots -> Size :=
  fun (ms : Members) (t : Hash) (bs : Ballots) => elim (fun (k : Members) => Size) sz0
    (fun (q : Party) (r : Members) (ih : Size) => elim (fun (s : Sum Unit Unit) => Size) (fun (u : Unit) => ih) (fun (u : Unit) => szS ih) (blHas q t bs)) ms
def authorize : Params -> Hash -> Ballots -> Sum Unit Unit :=
  fun (p : Params) (t : Hash) (bs : Ballots) => szLe (prAmendT p) (blCount (cmMembers (prCommittee p)) t bs)
-- An amendment moves the Params to amTo; the ballots are in the
-- amendment. amendMsg has the kind tag 2 (Q-S7-2 (a)). amendCheck p a cs gives
-- invalid notAccepted when the ballots do not authorize a, invalid badCert
-- when cs does not certify the amend message, else valid.
family Amendment := amendment (amTag : Size) (amTo : Params) (amBallots : Ballots)
def amendMsg : Amendment -> Hash := fun (a : Amendment) => hash (hsMsg (szToFe (szS (szS sz0))) (szToFe (amTag a)) feZero)
def amendCheck : Params -> Amendment -> Certificate -> Verdict :=
  fun (p : Params) (a : Amendment) (cs : Certificate) =>
    vdCheck (authorize p (amendMsg a) (amBallots a)) notAccepted
      (vdCheck (checkCert (prCommittee p) (amendMsg a) cs) badCert valid)
-- A log entry (Q-S7-1 (a)) is an amendment from eaFrom to eaTo, a slash or
-- a bid claim. The proof field eaOk says that the EARLIER Params accept the
-- amendment (G5): Params cannot authorize themselves. When the kernel
-- cannot check eaOk, the checker gives REFUSE_FIXPOINT. A slash and a
-- claim keep the Params. A release is not a log entry (OI-35).
family Entry : Params -> Params -> Type 0 := enAmend (eaFrom : Params) (eaTo : Params) (eaTag : Size) (eaBallots : Ballots) (eaCert : Certificate) (eaOk : Path Verdict (amendCheck eaFrom (amendment eaTag eaTo eaBallots) eaCert) valid) : Entry eaFrom eaTo
  | enSlash (esAt : Params) (esRoot : Root) (esHandle : Handle) (esC : Commitment) (esE : EligibilityProof) (esD : Commitment) (esF : EligibilityProof) : Entry esAt esAt
  | enAdmit (edAt : Params) (edRoot : Root) (edBid : SealedBid) (edHeight : Height) (edCert : Certificate) : Entry edAt edAt
-- The log (CM, Q-S7-1 (a)): the free category on the entries, nil, cons
-- and append. G4 (Q-S7-5 (a)): nil is a unit and append is associative
-- (paths by induction). The log has no bound (OI-36).
family Log : Params -> Params -> Type 0 := lgNil (lgNilOf : Params) : Log lgNilOf lgNilOf
  | lgCons (lgFrom : Params) (lgMid : Params) (lgTo : Params) (lgHead : Entry lgFrom lgMid) (lgTail : Log lgMid lgTo) : Log lgFrom lgTo
def append : (P : Params) -> (Q : Params) -> (R : Params) -> Log P Q -> Log Q R -> Log P R :=
  fun (P : Params) (Q : Params) (R : Params) (l : Log P Q) => elim (fun (p : Params) (q : Params) (k : Log p q) => Log q R -> Log p R)
    (fun (n : Params) => fun (m : Log n R) => m)
    (fun (x : Params) (y : Params) (z : Params) (hd : Entry x y) (tl : Log y z) (ih : Log z R -> Log y R) => fun (m : Log z R) => lgCons x y R hd (ih m)) l
def appendNilL : (P : Params) -> (Q : Params) -> (l : Log P Q) -> Path (Log P Q) (append P P Q (lgNil P) l) l :=
  fun (P : Params) (Q : Params) (l : Log P Q) => fun (i : I) => l
def appendNilR : (P : Params) -> (Q : Params) -> (l : Log P Q) -> Path (Log P Q) (append P Q Q l (lgNil Q)) l :=
  fun (P : Params) (Q : Params) (l : Log P Q) => elim (fun (p : Params) (q : Params) (k : Log p q) => Path (Log p q) (append p q q k (lgNil q)) k)
    (fun (n : Params) => fun (i : I) => lgNil n)
    (fun (x : Params) (y : Params) (z : Params) (hd : Entry x y) (tl : Log y z) (ih : Path (Log y z) (append y z z tl (lgNil z)) tl) => fun (i : I) => lgCons x y z hd (ih @ i)) l
def appendAssoc : (P : Params) -> (Q : Params) -> (R : Params) -> (S : Params) -> (a : Log P Q) -> (b : Log Q R) -> (c : Log R S) -> Path (Log P S) (append P Q S a (append Q R S b c)) (append P R S (append P Q R a b) c) :=
  fun (P : Params) (Q : Params) (R : Params) (S : Params) (a : Log P Q) => elim (fun (p : Params) (q : Params) (k : Log p q) => (b : Log q R) -> (c : Log R S) -> Path (Log p S) (append p q S k (append q R S b c)) (append p R S (append p q R k b) c))
    (fun (n : Params) => fun (b : Log n R) (c : Log R S) => fun (i : I) => append n R S b c)
    (fun (x : Params) (y : Params) (z : Params) (hd : Entry x y) (tl : Log y z) (ih : (b : Log z R) -> (c : Log R S) -> Path (Log y S) (append y z S tl (append z R S b c)) (append y R S (append y z R tl b) c)) => fun (b : Log z R) (c : Log R S) => fun (i : I) => lgCons x y S hd ((ih b c) @ i)) a
-- paramsAt (G5, Q-S7-3 (a)): the Params at a log height. Height 0 is the
-- first Params, height h + 1 is the Params of the tail at h, and a height
-- after the end is the last Params. The step reads h with szIsZ and szDec
-- (one ih call for each step). The machine (CC) is the stream of the
-- Params at the heights 0, 1, 2 and so on.
def paramsAtSize : (P : Params) -> (Q : Params) -> Log P Q -> Size -> Params :=
  fun (P : Params) (Q : Params) (l : Log P Q) => elim (fun (p : Params) (q : Params) (k : Log p q) => Size -> Params)
    (fun (n : Params) => fun (h : Size) => n)
    (fun (x : Params) (y : Params) (z : Params) (hd : Entry x y) (tl : Log y z) (ih : Size -> Params) => fun (h : Size) =>
      elim (fun (s : Sum Unit Unit) => Params) (fun (u : Unit) => ih (szDec h)) (fun (u : Unit) => x) (szIsZ h)) l
def paramsAt : (P : Params) -> (Q : Params) -> Log P Q -> Height -> Params :=
  fun (P : Params) (Q : Params) (l : Log P Q) (h : Height) => paramsAtSize P Q l (htOf h)
def Machine : Type 0 := Stream Params
def machineOf : (P : Params) -> (Q : Params) -> Log P Q -> Machine :=
  fun (P : Params) (Q : Params) (l : Log P Q) => sCorec Params Size (paramsAtSize P Q l) (fun (h : Size) => szS h) sz0
-- replay (Q-S7-4 (a)): the verdict of each entry from left to right. The
-- slashed handles go along the log: a valid slash entry adds its handle,
-- and admit reads the handles of the earlier entries (OI-29). An amend
-- entry is valid, because its proof field eaOk holds.
family Verdicts := vdNil | vdCons (vdHead : Verdict) (vdTail : Verdicts)
def entryVerdict : (a : Params) -> (b : Params) -> Entry a b -> Handles -> Verdict :=
  fun (a : Params) (b : Params) (e : Entry a b) => elim (fun (x : Params) (y : Params) (k : Entry x y) => Handles -> Verdict)
    (fun (f : Params) (t : Params) (g : Size) (bs : Ballots) (cs : Certificate) (ok : Path Verdict (amendCheck f (amendment g t bs) cs) valid) => fun (sl : Handles) => valid)
    (fun (p : Params) (r : Root) (h : Handle) (c : Commitment) (e1 : EligibilityProof) (d : Commitment) (f1 : EligibilityProof) => fun (sl : Handles) => slash r h c e1 d f1)
    (fun (p : Params) (r : Root) (b : SealedBid) (h : Height) (cs : Certificate) => fun (sl : Handles) => admit p sl r b h cs) e
def entrySlashed : (a : Params) -> (b : Params) -> Entry a b -> Handles -> Handles :=
  fun (a : Params) (b : Params) (e : Entry a b) => elim (fun (x : Params) (y : Params) (k : Entry x y) => Handles -> Handles)
    (fun (f : Params) (t : Params) (g : Size) (bs : Ballots) (cs : Certificate) (ok : Path Verdict (amendCheck f (amendment g t bs) cs) valid) => fun (sl : Handles) => sl)
    (fun (p : Params) (r : Root) (h : Handle) (c : Commitment) (e1 : EligibilityProof) (d : Commitment) (f1 : EligibilityProof) => fun (sl : Handles) => elim (fun (v : Verdict) => Handles) (hlCons h sl) (fun (w : Reason) => sl) (slash r h c e1 d f1))
    (fun (p : Params) (r : Root) (b : SealedBid) (h : Height) (cs : Certificate) => fun (sl : Handles) => sl) e
def replayFrom : (P : Params) -> (Q : Params) -> Log P Q -> Handles -> Verdicts :=
  fun (P : Params) (Q : Params) (l : Log P Q) => elim (fun (p : Params) (q : Params) (k : Log p q) => Handles -> Verdicts)
    (fun (n : Params) => fun (sl : Handles) => vdNil)
    (fun (x : Params) (y : Params) (z : Params) (hd : Entry x y) (tl : Log y z) (ih : Handles -> Verdicts) => fun (sl : Handles) => vdCons (entryVerdict x y hd sl) (ih (entrySlashed x y hd sl))) l
def replay : (P : Params) -> (Q : Params) -> Log P Q -> Verdicts :=
  fun (P : Params) (Q : Params) (l : Log P Q) => replayFrom P Q l hlNil
def slashedFrom : (P : Params) -> (Q : Params) -> Log P Q -> Handles -> Handles :=
  fun (P : Params) (Q : Params) (l : Log P Q) => elim (fun (p : Params) (q : Params) (k : Log p q) => Handles -> Handles)
    (fun (n : Params) => fun (sl : Handles) => sl)
    (fun (x : Params) (y : Params) (z : Params) (hd : Entry x y) (tl : Log y z) (ih : Handles -> Handles) => fun (sl : Handles) => ih (entrySlashed x y hd sl)) l
def slashedOf : (P : Params) -> (Q : Params) -> Log P Q -> Handles :=
  fun (P : Params) (Q : Params) (l : Log P Q) => slashedFrom P Q l hlNil
-- P3 on the log (Q-S7-4 (a)): a slash entry with two equal commitments is
-- never valid.
def p3Replay : (P : Params) -> (r : Root) -> (h : Handle) -> (c : Commitment) -> (e : EligibilityProof) -> (f : EligibilityProof) -> Path Verdicts (replay P P (lgCons P P P (enSlash P r h c e c f) (lgNil P))) (vdCons (invalid notAccepted) vdNil) :=
  fun (P : Params) (r : Root) (h : Handle) (c : Commitment) (e : EligibilityProof) (f : EligibilityProof) =>
    cong (fun (v : Verdict) => vdCons v vdNil) (p3Slash r h c e f)
