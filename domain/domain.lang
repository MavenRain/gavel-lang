-- Schnorr on G1 (S8a, as src/crypto/schnorr.c of ratify-lang): (R, s) is a
-- valid signature on m by the key P when s G = R + e P, with
-- e = kcChallenge R.x R.y P.x P.y m. P and R must be points of the curve
-- y^2 = x^3 + 3 with each coordinate less than p, and s must be less than r.
-- Each value is canonical (not in Montgomery form). g1Gen is G = (1, 2).
def g1Gen : Pt1 := pt1 (fe 1w 0w 0w 0w 0w 0w 0w 0w) (fe 2w 0w 0w 0w 0w 0w 0w 0w)
def scOnCurve : Pt1 -> Sum Unit Unit :=
  fun (p : Pt1) => (fun (q : Pt1) => feEq (feMulC fpMod (p1Y q) (p1Y q)) (feAdd fpMod (feMulC fpMod (feMulC fpMod (p1X q) (p1X q)) (p1X q)) (feToMont fpMod (fe 3w 0w 0w 0w 0w 0w 0w 0w)))) (ptToMont fpMod p)
def scValid : Pt1 -> Sum Unit Unit :=
  fun (p : Pt1) => sAnd (feLt (p1X p) (modM fpMod)) (sAnd (feLt (p1Y p) (modM fpMod)) (scOnCurve p))
def scPtEq : Pt1 -> Pt1 -> Sum Unit Unit := fun (a : Pt1) (b : Pt1) => sAnd (feEq (p1X a) (p1X b)) (feEq (p1Y a) (p1Y b))
-- scEquation e P R s is s G = R + e P, with P and R in Montgomery form. The
-- two scalar products use the C builtin ptMulC (Q-S8a-7 (a)). R goes in as
-- the Jac (R.x, R.y, 1).
def scEquation : Fe -> Pt1 -> Pt1 -> Fe -> Sum Unit Unit :=
  fun (e : Fe) (pm : Pt1) (rm : Pt1) (s : Fe) => scPtEq (ptMulC fpMod s (ptToMont fpMod g1Gen)) (ptToAffine fpMod (ptMadd fpMod (jac (p1X rm) (p1Y rm) (modR1 fpMod)) (ptMulC fpMod e pm)))
def schnorrCheck : KRcs -> Pt1 -> Pt1 -> Fe -> Fe -> Sum Unit Unit :=
  fun (rcs : KRcs) (pk : Pt1) (r : Pt1) (s : Fe) (m : Fe) =>
    sAnd (scValid pk) (sAnd (scValid r) (sAnd (feLt s (modM frMod)) (scEquation (kcChallenge rcs (p1X r) (p1Y r) (p1X pk) (p1Y pk) m) (ptToMont fpMod pk) (ptToMont fpMod r) s)))
-- The message words (S8a). szToFe n is n in Fr, in Montgomery form (n
-- additions of R mod r). hsMsg t x y is poseidon2 (t, poseidon2 (x, y)) in
-- Fr. Each input is in Montgomery form. The result is canonical, because
-- kcChallenge reads a canonical message.
def szToFe : Size -> Fe :=
  fun (n : Size) => elim (fun (a : Size) => Fe) feZero (fun (a : Size) (ih : Fe) => feAdd frMod ih (modR1 frMod)) n
def hsMsg : Fe -> Fe -> Fe -> Fe :=
  fun (t : Fe) (x : Fe) (y : Fe) => feFromMont frMod (poseidon2 frMod psMdsFr psRcsFr t (poseidon2 frMod psMdsFr psRcsFr x y))
-- The test fixtures (S8a). fxKeyK is the key K G of the secret key K (1 to
-- 5). fx<NAME>K<K>R and fx<NAME>K<K>S are the signature (R, s) of the key K
-- on the message NAME. Hs2 and Hs3 are the tags 2 and 3. StA and StL are
-- hsMsg (0, 1, 1) and hsMsg (0, 1, 2): the stamps of the commitment 1 at the
-- heights 1 and 2. OpA and OpE are hsMsg (1, 1, 2) and hsMsg (1, 1, 1): the
-- openings of the auction 1 at the heights 2 and 1. AmA is hsMsg (2, 0, 0):
-- the amendment 0. Each value is canonical. `cryptotool fixtures`
-- (test/cryptotool.c) prints these lines.
